{
  "name": "adp-calendar",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.9.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit && pnpm --filter @adp-calendar/extension typecheck",
    "type-check": "tsc --noEmit && pnpm --filter @adp-calendar/extension typecheck",
    "build": "pnpm -r --if-present build",
    "build:extension": "pnpm --filter @adp-calendar/extension build"
  },
  "devDependencies": {
    "@types/node": "^24.9.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
