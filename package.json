{
  "name": "adp-calendar",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit && bun run --cwd packages/extension typecheck",
    "type-check": "tsc --noEmit && bun run --cwd packages/extension typecheck",
    "build": "bun run --filter \"@adp-calendar/*\" --if-present build",
    "build:extension": "bun run --cwd packages/extension build",
    "build:userscript": "bun run --cwd packages/userscript build",
    "zip:extension": "bun run --cwd packages/extension zip:store",
    "store:upload": "chrome-webstore-upload upload --source packages/extension/.output/chrome-mv3",
    "store:publish": "chrome-webstore-upload publish",
    "store:status": "bun scripts/store-status.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "chrome-webstore-upload-cli": "4.0.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "workspaces": [
    "packages/core",
    "packages/userscript",
    "packages/extension"
  ]
}
