{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": ["node"]
  },
  "include": [
    "packages/core/src",
    "packages/core/test",
    "packages/userscript/src",
    "packages/userscript/test",
    "packages/userscript/vite.config.ts",
    "packages/extension/src",
    "packages/extension/test",
    "vitest.config.ts"
  ],
  "exclude": [
    "packages/extension/src/entrypoints",
    "packages/extension/src/popup",
    "packages/extension/src/browser"
  ]
}
